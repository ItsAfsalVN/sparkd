rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Gigs collection
    match /gigs/{gigId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
                         request.auth.uid == resource.data.creatorId;
  
      // Allow any authenticated user to increment totalViews
      allow update: if request.auth != null && 
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalViews']);

      // Views subcollection - track who viewed this gig
      match /views/{userId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if request.auth != null && 
                   (request.auth.uid == resource.data.smeID || 
                    request.auth.uid == resource.data.sparkID);
      allow create: if request.auth != null && 
                     request.auth.uid == request.resource.data.smeID;
      allow update: if request.auth != null && 
                     (request.auth.uid == resource.data.smeID || 
                      request.auth.uid == resource.data.sparkID);
      allow delete: if request.auth != null && 
                     request.auth.uid == resource.data.smeID;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                   request.auth.uid == resource.data.userId;
      allow write: if request.auth != null;
    }

    // Workshops collection (for workshop messages/chat)
    match /workshops/{workshopId} {
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && 
                               request.auth.uid == resource.data.senderId;
      }
    }
  }
}
